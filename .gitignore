.venv/
venv/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.env
# logs/* rather than logs/: git cannot re-include a file whose parent directory
# is excluded, and llm_usage.jsonl is the tracked cost ledger (SPEC §10).
logs/*
!logs/decisions.jsonl
data/*.db
.cache/
# CEFR wordlists (SPEC §5 signal 1). The lookup code is tracked; the DATA is not --
# Goethe/DWDS lists carry licensing this repo cannot redistribute, so anything dropped
# here stays local. `*.txt` deliberately does not match vocab/cefr/README.md, which stays
# tracked and is what keeps the directory present on a fresh clone (so no .gitkeep and no
# `!` negation are needed). Absent lists are a supported state, not a broken one.
vocab/cefr/*.txt
# Staging for ingested candidates awaiting `gw promote` (ADR-003). Not a durable
# artifact -- /raw and /nodes are the tracked record.
queue/
# Same reasoning one slice on: pending adjudication results awaiting `gw review`.
# A proposal is resolved by approval-or-rejection and deleted either way, so the
# directory only ever holds pending work. The durable record of what happened is
# the commit to /nodes that an approval produces, plus logs/decisions.jsonl.
proposals/
